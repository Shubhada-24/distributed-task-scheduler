FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=task_scheduler
MYSQL_USER=scheduler
MYSQL_PASSWORD=scheduler_pass
MYSQL_ROOT_PASSWORD=root_pass
NUM_WORKERS=3
SCHEDULER_POLL_INTERVAL=1.0
WORKER_HEARTBEAT_INTERVAL=5.0
LOG_LEVEL=INFO
# Optional: SQLite for a quick local demo without MySQL
# DATABASE_URL=sqlite:///scheduler.db
# Set when running flask db commands so background workers are not started
# FLASK_SKIP_RUNTIME=1
